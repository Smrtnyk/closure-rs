+    if (name == null) {
+      for (Field f : DiagnosticGroups.class.getDeclaredFields()) {
+        if (Modifier.isStatic(f.getModifiers()) && f.getType() == DiagnosticGroup.class) {
+          try {
+            f.setAccessible(true);
+            if (f.get(null) == g) {
+              name = "DiagnosticGroups." + f.getName();
+              break;
+            }
+          } catch (ReflectiveOperationException | RuntimeException e) {
+            // ignore
+          }
+        }
+      }
+    }
+    o.addProperty("group", name);
+    JsonArray types = new JsonArray();
+    for (DiagnosticType t : g.getTypes()) {
+      types.add(t.key);
+    }
+    o.add("types", types);
+    return o;
+  }
+
+  public static JsonArray errors(List<JSError> errs) {
+    JsonArray a = new JsonArray();
+    for (JSError e : errs) {
+      JsonObject o = new JsonObject();
+      o.addProperty("key", e.type().key);
+      o.addProperty("defaultLevel", String.valueOf(e.getDefaultLevel()));
+      o.addProperty("description", e.description());
+      o.addProperty("source", e.sourceName());
+      o.addProperty("line", e.lineno());
+      o.addProperty("charno", e.charno());
+      o.addProperty("length", e.length());
+      a.add(o);
+    }
+    return a;
+  }
+
+  /**
+   * Referenceable dump mode (D-015 e, FORMAT.md "Referenceable values"): used for test-instance
+   * fields (entry and after the call) and the processor dump. A value the dump cannot represent
+   * (a lambda, a cycle, an object nested deeper than the dump depth, a field reflection cannot
+   * read) is written as a class-name reference {"ref": FQCN} (a lambda keeps its "captures") and
+   * is NOT listed in `unrepresentable`: no descriptor or harness decodes those values.
+   */
+  private static final ThreadLocal<Boolean> REFS = ThreadLocal.withInitial(() -> false);
+
+  public static JsonObject refFields(Object v, Class<?> c, Class<?> stop, String path, int depthLeft) {
+    boolean old = REFS.get();
+    REFS.set(true);
+    try {
+      return fields(v, c, stop, path, null, depthLeft, new IdentityHashMap<>());
+    } finally {
+      REFS.set(old);
+    }
+  }
+
+  public static JsonElement refValue(Object v, String path, int maxDepth) {
+    boolean old = REFS.get();
+    REFS.set(true);
+    try {
+      return dump(v, path, null, maxDepth, new IdentityHashMap<>());
+    } finally {
+      REFS.set(old);
+    }
+  }
+
+  private static JsonObject ref(String cls) {
+    JsonObject o = new JsonObject();
+    o.addProperty("ref", cls);
+    return o;
+  }
+
+  /** Simple-mode dump: primitives, strings, enums, collections of these; else {"object":cls}. */
+  public static JsonElement value(Object v, String path, JsonArray unrep, int maxDepth) {
+    return dump(v, path, unrep, maxDepth, new IdentityHashMap<>());
+  }
+
+  /** A test instance (captured by a lambda or held in a field): referenced, never dumped. */
+  private static boolean isHarnessInstance(Class<?> c) {
+    for (Class<?> k = c; k != null; k = k.getSuperclass()) {
+      String n = k.getName();
+      if (n.equals("com.google.javascript.jscomp.CompilerTestCase")
+          || n.equals("com.google.javascript.jscomp.CompilerTypeTestCase")
+          || n.equals("com.google.javascript.jscomp.integration.IntegrationTestCase")) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Stable class name: a hidden lambda class's name ends in a run-dependent address
+   * ("Foo$$Lambda/0x0000..."), which is dropped ("Foo$$Lambda").
+   */
+  public static String className(Class<?> c) {
+    String n = c.getName();
+    int i = n.indexOf("$$Lambda");
+    return i < 0 ? n : n.substring(0, i + "$$Lambda".length());
+  }
+
+  private static boolean isLambda(Class<?> c) {
+    return c.isSynthetic() || c.getName().contains("$$Lambda") || c.isHidden();
+  }
+
+  /**
+   * Adds the entries of {@code from} whose path is {@code prefix + "." + k} (or below it) for a key
+   * k in {@code keys} to {@code to}: the unrepresentable values of a diffed dump's kept fields.
+   */
+  public static void addUnrepFor(JsonArray to, JsonArray from, String prefix, Set<String> keys) {
+    if (to == null) {
+      return;
+    }
+    for (JsonElement e : from) {
+      String path = e.getAsJsonObject().get("path").getAsString();
+      for (String k : keys) {
+        String p = prefix + "." + k;
