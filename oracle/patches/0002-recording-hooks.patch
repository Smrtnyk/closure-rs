+    rec.o.add("options", UnitRecorder.optionsDiff(t.compiler.getOptions(), rec.unrep));
+  }
+
+  static void __recordTypeObserved(UnitRecorder.Rec rec, Compiler compiler) {
+    com.google.gson.JsonObject obs = UnitRecorder.obj(rec, "observed");
+    try {
+      obs.add("errors", UnitRecorder.errors(compiler.getErrors()));
+      obs.add("warnings", UnitRecorder.errors(compiler.getWarnings()));
+    } catch (RuntimeException e) {
+      obs.addProperty("observeError", e.toString());
+    }
+  }
