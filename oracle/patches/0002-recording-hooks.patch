+          o.add("captures", fields(v, c, Object.class, path + ".captures", null, depthLeft - 1, seen));
+        } finally {
+          seen.remove(v);
+        }
+      }
+      return o;
+    }
+    if (isHarnessInstance(c)) {
+      JsonObject o = new JsonObject();
+      o.addProperty("ref", c.getName());
+      return o;
+    }
+    if (seen.containsKey(v)) {
+      if (REFS.get()) {
+        return ref(c.getName());
+      }
+      unrep(unrep, path, "cycle");
+      JsonObject o = new JsonObject();
+      o.addProperty("unrepresentable", "cycle:" + c.getName());
