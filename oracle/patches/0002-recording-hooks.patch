+  }
+
+  private static String truncateType(String t) {
+    return t.length() <= 2000 ? t : t.substring(0, 2000) + "...<truncated " + (t.length() - 2000) + " chars>";
+  }
+
+  private static void unrep(JsonArray unrep, String path, String reason) {
+    if (unrep == null) {
+      return;
+    }
+    JsonObject o = new JsonObject();
+    o.addProperty("path", path);
+    o.addProperty("reason", reason);
+    unrep.add(o);
+  }
+
+  private static JsonElement dump(
+      Object v, String path, JsonArray unrep, int depthLeft, IdentityHashMap<Object, Boolean> seen) {
+    if (v == null) {
+      return JsonNull.INSTANCE;
+    }
+    if (v instanceof String s) {
+      return new JsonPrimitive(s);
+    }
+    if (v instanceof Boolean b) {
+      return new JsonPrimitive(b);
+    }
+    if (v instanceof Integer || v instanceof Short || v instanceof Byte) {
+      return new JsonPrimitive((Number) v);
+    }
+    if (v instanceof Long l) {
+      JsonObject o = new JsonObject();
+      o.addProperty("long", l.toString());
+      return o;
+    }
+    if (v instanceof Double || v instanceof Float) {
+      JsonObject o = new JsonObject();
+      o.addProperty("double", Double.toString(((Number) v).doubleValue()));
+      return o;
+    }
+    if (v instanceof Character c) {
+      JsonObject o = new JsonObject();
+      o.addProperty("char", String.valueOf(c));
+      return o;
+    }
+    if (v instanceof Enum<?> e) {
+      JsonObject o = new JsonObject();
+      o.addProperty("enum", e.getDeclaringClass().getName());
+      o.addProperty("name", e.name());
+      return o;
+    }
+    if (v instanceof DiagnosticType t) {
+      JsonObject o = new JsonObject();
+      o.add("diagnosticType", diagnosticType(t));
+      return o;
+    }
+    if (v instanceof DiagnosticGroup g) {
+      JsonObject o = new JsonObject();
+      o.add("diagnosticGroup", diagnosticGroup(g));
+      return o;
+    }
