+/*
+ * closure-rs unit-corpus recording hook (oracle/patches/0002-recording-hooks.patch).
+ * Inactive unless the system property closurers.unit.record is set (so Bazel runs are unaffected).
+ * Writes one JSON line per outermost call to a hooked harness API. Format: corpus/unit/FORMAT.md.
+ */
+package com.google.javascript.jscomp;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import java.io.IOException;
+import java.io.Writer;
+import java.lang.reflect.Array;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/** Records harness API calls as self-contained JSON records. */
+public final class UnitRecorder {
+  public static final int FORMAT_VERSION = 2;
+  private static final Gson GSON =
+      new GsonBuilder().disableHtmlEscaping().serializeNulls().serializeSpecialFloatingPointValues().create();
+
+  private UnitRecorder() {}
+
+  /** Active only when -Dclosurers.unit.record=true (set by UnitRecordingMain). */
+  public static final boolean ENABLED = Boolean.getBoolean("closurers.unit.record");
+
+  // ---- current test, set by the recording runner's RunListener ----
+  public static volatile String currentClass = null;
+  public static volatile String currentMethod = null;
+  private static Writer out = null;
+  private static final Map<String, Integer> callIndexByTest = new LinkedHashMap<>();
+  /** All entries to hooked APIs (any depth), by "kind:method". */
+  public static final Map<String, Integer> entries = new LinkedHashMap<>();
+  /** Outermost entries (one record each), by "kind:method". */
+  public static final Map<String, Integer> outermost = new LinkedHashMap<>();
+  public static int recordsWritten = 0;
+  public static int recordsWithUnrepresentable = 0;
+  private static final ThreadLocal<Integer> depth = ThreadLocal.withInitial(() -> 0);
+
+  public static synchronized void setOutput(Writer w) {
+    out = w;
+    callIndexByTest.clear();
+  }
+
+  /** A record under construction. */
+  public static final class Rec {
+    public final JsonObject o = new JsonObject();
+    public final JsonArray unrep = new JsonArray();
+    public boolean processorSeen = false;
+    /** The processor of the first repetition (post-call snapshot producer root). */
+    public Object processorObj;
+    public Object instance;
+  }
+
+  private static synchronized void count(Map<String, Integer> m, String k) {
+    m.merge(k, 1, Integer::sum);
+  }
+
+  /** Called at every hooked entry; returns a Rec only for the outermost hooked call. */
+  public static Rec enter(Object instance, String kind, String method) {
+    if (!ENABLED) {
+      return null;
+    }
+    count(entries, kind + ":" + method);
+    int d = depth.get();
+    depth.set(d + 1);
+    if (d != 0) {
+      return null;
+    }
+    count(outermost, kind + ":" + method);
+    Rec r = new Rec();
+    r.instance = instance;
+    String cls = currentClass != null ? currentClass : (instance != null ? instance.getClass().getName() : "?");
+    String m = currentMethod != null ? currentMethod : "?";
+    int idx;
+    synchronized (UnitRecorder.class) {
+      idx = callIndexByTest.merge(cls + "#" + m, 1, Integer::sum) - 1;
+    }
+    r.o.addProperty("v", FORMAT_VERSION);
+    r.o.addProperty("class", cls);
+    r.o.addProperty("method", m);
+    r.o.addProperty("call", idx);
+    r.o.addProperty("kind", kind);
+    r.o.addProperty("api", method);
+    if (instance != null) {
+      r.o.addProperty("instanceClass", instance.getClass().getName());
+    }
+    traceBegin();
+    return r;
+  }
+
+  // ---- pass trace (D-017 item 8, FORMAT.md "passTrace") ----
+  // The NoopAgent in TRACE mode (-javaagent:noop-agent.jar=trace=<scope>) is on the system class
+  // path; it is reached by reflection so the recorder also runs without it (then no passTrace).
+  private static final java.lang.reflect.Method[] TRACE = traceMethods();
+
+  private static java.lang.reflect.Method[] traceMethods() {
+    try {
+      Class<?> t = Class.forName("closurers.agent.Trace", true, ClassLoader.getSystemClassLoader());
+      if (!(Boolean) t.getMethod("active").invoke(null)) {
+        return null;
+      }
+      return new java.lang.reflect.Method[] {t.getMethod("begin"), t.getMethod("end")};
+    } catch (ReflectiveOperationException | LinkageError e) {
+      return null;
+    }
+  }
+
+  private static void traceBegin() {
+    if (TRACE == null) {
+      return;
+    }
+    try {
+      TRACE[0].invoke(null);
+    } catch (ReflectiveOperationException e) {
+      throw new RuntimeException(e);
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private static JsonArray traceEnd() {
+    if (TRACE == null) {
+      return null;
+    }
+    try {
+      JsonArray a = new JsonArray();
+      for (String s : (List<String>) TRACE[1].invoke(null)) {
+        a.add(s);
+      }
+      return a;
+    } catch (ReflectiveOperationException e) {
+      throw new RuntimeException(e);
+    }
+  }
+
+  /** Must be called in a finally block for every enter(). */
+  public static void exit(Rec r) {
+    if (!ENABLED) {
+      return;
+    }
+    depth.set(depth.get() - 1);
+    if (r == null) {
+      return;
+    }
+    JsonArray trace = traceEnd();
+    if (trace != null) {
+      r.o.add("passTrace", trace);
+    }
+    if (!r.o.has("outcome")) {
+      JsonObject oc = new JsonObject();
+      oc.addProperty("status", "normal");
+      r.o.add("outcome", oc);
+    }
+    r.o.add("unrepresentable", r.unrep);
+    write(r);
+  }
+
+  public static void fail(Rec r, Throwable t) {
+    if (r == null) {
+      return;
+    }
+    JsonObject oc = new JsonObject();
+    oc.addProperty("status", "exception");
+    oc.addProperty("exceptionClass", t.getClass().getName());
+    String msg = t.getMessage();
+    oc.addProperty("message", msg == null ? null : truncate(msg, 4000));
+    oc.addProperty("assertion", t instanceof AssertionError);
+    r.o.add("outcome", oc);
+  }
+
+  private static String truncate(String s, int n) {
+    return s.length() <= n ? s : s.substring(0, n) + "...<truncated " + (s.length() - n) + " chars>";
+  }
+
+  private static synchronized void write(Rec r) {
+    if (out == null) {
+      return;
+    }
+    if (r.unrep.size() > 0) {
+      recordsWithUnrepresentable++;
+    }
+    try {
+      out.write(escapeLoneSurrogates(GSON.toJson(r.o)));
+      out.write('\n');
+      recordsWritten++;
+    } catch (IOException e) {
+      throw new RuntimeException(e);
+    }
+  }
+
+  /**
+   * JSON strings are UTF-16. A lone surrogate cannot be encoded as UTF-8, so it is written as a
+   * {@code \\uXXXX} escape (FORMAT.md "Strings"); paired surrogates stay literal (4-byte UTF-8).
+   */
+  static String escapeLoneSurrogates(String json) {
+    StringBuilder sb = null;
+    int n = json.length();
+    for (int i = 0; i < n; i++) {
+      char c = json.charAt(i);
+      boolean lone = false;
+      if (Character.isHighSurrogate(c)) {
+        if (i + 1 < n && Character.isLowSurrogate(json.charAt(i + 1))) {
+          if (sb != null) {
+            sb.append(c).append(json.charAt(i + 1));
+          }
+          i++;
+          continue;
+        }
+        lone = true;
+      } else if (Character.isLowSurrogate(c)) {
+        lone = true;
+      }
+      if (lone && sb == null) {
+        sb = new StringBuilder(n + 16).append(json, 0, i);
+      }
+      if (sb != null) {
+        if (lone) {
+          sb.append(String.format("\\u%04x", (int) c));
+        } else {
+          sb.append(c);
+        }
+      }
+    }
+    return sb == null ? json : sb.toString();
+  }
+
+  public static void put(Rec r, String key, JsonElement value) {
+    if (r != null) {
+      r.o.add(key, value);
+    }
+  }
+
+  public static JsonObject obj(Rec r, String key) {
+    JsonObject x = r.o.has(key) ? r.o.getAsJsonObject(key) : new JsonObject();
+    r.o.add(key, x);
+    return x;
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // Value encoding (see corpus/unit/FORMAT.md, "Value encoding")
+  // ---------------------------------------------------------------------------------------------
+
+  public static JsonElement sourceFiles(List<SourceFile> files) {
+    if (files == null) {
+      return JsonNull.INSTANCE;
+    }
+    JsonArray a = new JsonArray();
+    for (SourceFile f : files) {
+      a.add(sourceFile(f));
+    }
+    return a;
+  }
+
+  public static JsonObject sourceFile(SourceFile f) {
+    JsonObject o = new JsonObject();
+    o.addProperty("name", f.getName());
+    try {
+      o.addProperty("code", f.getCode());
+    } catch (IOException e) {
+      o.addProperty("codeError", e.toString());
+    }
+    o.addProperty("kind", String.valueOf(f.getKind()));
+    return o;
+  }
+
+  public static JsonElement chunks(List<JSChunk> chunks) {
+    JsonArray a = new JsonArray();
+    for (JSChunk c : chunks) {
+      JsonObject o = new JsonObject();
+      o.addProperty("name", c.getName());
+      JsonArray deps = new JsonArray();
+      for (JSChunk d : c.getDependencies()) {
+        deps.add(d.getName());
+      }
+      o.add("deps", deps);
+      JsonArray in = new JsonArray();
+      for (CompilerInput ci : c.getInputs()) {
+        in.add(sourceFile(ci.getSourceFile()));
+      }
+      o.add("inputs", in);
+      a.add(o);
+    }
+    return a;
+  }
+
+  public static JsonElement strings(String[] s) {
+    if (s == null) {
+      return JsonNull.INSTANCE;
+    }
+    JsonArray a = new JsonArray();
+    for (String x : s) {
+      a.add(x);
+    }
+    return a;
+  }
+
+  public static JsonObject diagnosticType(DiagnosticType t) {
+    JsonObject o = new JsonObject();
+    o.addProperty("key", t.key);
+    o.addProperty("level", String.valueOf(t.level));
+    return o;
+  }
+
+  public static JsonElement diagnosticGroup(DiagnosticGroup g) {
+    if (g == null) {
+      return JsonNull.INSTANCE;
+    }
+    JsonObject o = new JsonObject();
+    String name = null;
+    try {
+      for (Map.Entry<String, DiagnosticGroup> e : DiagnosticGroups.getRegisteredGroups().entrySet()) {
+        if (e.getValue() == g) {
+          name = e.getKey();
+          break;
+        }
+      }
+    } catch (RuntimeException e) {
+      // ignore
