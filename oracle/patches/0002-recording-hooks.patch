+          JsonArray kv = new JsonArray();
+          kv.add(dump(e.getKey(), path + "{k" + i + "}", unrep, depthLeft, seen));
+          kv.add(dump(e.getValue(), path + "{v" + i + "}", unrep, depthLeft, seen));
+          a.add(kv);
+          i++;
+        }
+        o.add("map", a);
+        o.addProperty("impl", c.getName());
+        return o;
+      }
+      if (v instanceof Collection<?> col) {
+        JsonObject o = new JsonObject();
+        JsonArray a = new JsonArray();
+        int i = 0;
+        for (Object x : col) {
+          a.add(dump(x, path + "[" + i++ + "]", unrep, depthLeft, seen));
+        }
+        o.add(v instanceof Set ? "set" : "list", a);
+        o.addProperty("impl", c.getName());
+        return o;
+      }
+      // D-017 item 2 (FORMAT.md "Neutral encodings"): a Guava Table as its cells, each
+      // [row, column, value], in cellSet() order, plus the implementation class.
+      if (v instanceof com.google.common.collect.Table<?, ?, ?> t) {
+        JsonObject o = new JsonObject();
+        JsonArray a = new JsonArray();
+        int i = 0;
+        for (com.google.common.collect.Table.Cell<?, ?, ?> cell : t.cellSet()) {
+          JsonArray rcv = new JsonArray();
+          rcv.add(dump(cell.getRowKey(), path + "{r" + i + "}", unrep, depthLeft, seen));
+          rcv.add(dump(cell.getColumnKey(), path + "{c" + i + "}", unrep, depthLeft, seen));
+          rcv.add(dump(cell.getValue(), path + "{v" + i + "}", unrep, depthLeft, seen));
+          a.add(rcv);
+          i++;
+        }
+        o.add("table", a);
+        o.addProperty("impl", c.getName());
+        return o;
+      }
+      // D-017 item 2 (FORMAT.md "Neutral encodings"): a protobuf message or builder by its
+      // descriptor: every set field by name, nested messages in full (no depth limit).
+      if (v instanceof com.google.protobuf.MessageOrBuilder msg) {
+        return protoValue(msg);
+      }
+      if (v instanceof Compiler || v instanceof com.google.javascript.rhino.Node) {
+        JsonObject o = new JsonObject();
+        o.addProperty("ref", c.getName());
+        return o;
+      }
+      if (depthLeft <= 0) {
+        if (REFS.get()) {
+          return ref(c.getName());
+        }
+        unrep(unrep, path, "object nesting too deep: " + c.getName());
+        JsonObject o = new JsonObject();
+        o.addProperty("unrepresentable", c.getName());
+        return o;
+      }
+      JsonObject o = new JsonObject();
+      o.addProperty("object", c.getName());
+      o.add("fields", fields(v, c, Object.class, path, unrep, depthLeft - 1, seen));
+      return o;
+    } finally {
+      seen.remove(v);
+    }
+  }
+
+  /**
+   * D-017 item 2 (FORMAT.md "Neutral encodings"): {"proto": descriptor full name, "fields": {name:
+   * value}} with the fields getAllFields() returns (the set fields, in field-number order); never the
+   * Java-only memoizedIsInitialized / memoizedSize / memoizedHashCode / unknownFields. Repeated fields
+   * (map fields included, as their entry messages) are arrays; enums are value names; 64-bit integers
+   * {"long": decimal}; floating point {"double": Double.toString}; bytes {"bytes": base64}, except
+   * StringPoolProto.strings (UTF-8 strings) and LazyAst.script (the encoded AstNode, as {"astNode":
+   * its message}).
+   */
+  private static JsonObject protoValue(com.google.protobuf.MessageOrBuilder m) {
+    JsonObject o = new JsonObject();
+    o.addProperty("proto", m.getDescriptorForType().getFullName());
+    JsonObject f = new JsonObject();
+    for (Map.Entry<com.google.protobuf.Descriptors.FieldDescriptor, Object> e : m.getAllFields().entrySet()) {
+      com.google.protobuf.Descriptors.FieldDescriptor fd = e.getKey();
+      if (fd.isRepeated()) {
+        JsonArray a = new JsonArray();
+        for (Object x : (List<?>) e.getValue()) {
+          a.add(protoScalar(m, fd, x));
+        }
+        f.add(fd.getName(), a);
+      } else {
+        f.add(fd.getName(), protoScalar(m, fd, e.getValue()));
+      }
+    }
+    o.add("fields", f);
+    return o;
+  }
+
+  private static JsonElement protoScalar(
+      com.google.protobuf.MessageOrBuilder owner, com.google.protobuf.Descriptors.FieldDescriptor fd, Object x) {
+    switch (fd.getJavaType()) {
+      case MESSAGE:
+        return protoValue((com.google.protobuf.MessageOrBuilder) x);
+      case ENUM:
+        return new JsonPrimitive(((com.google.protobuf.Descriptors.EnumValueDescriptor) x).getName());
+      case BYTE_STRING: {
+        com.google.protobuf.ByteString b = (com.google.protobuf.ByteString) x;
+        com.google.protobuf.Descriptors.Descriptor d = owner.getDescriptorForType();
+        if (d == com.google.javascript.jscomp.serialization.StringPoolProto.getDescriptor()
+            && fd.getName().equals("strings")) {
+          return new JsonPrimitive(b.toStringUtf8());
+        }
+        if (d == com.google.javascript.jscomp.serialization.LazyAst.getDescriptor() && fd.getName().equals("script")) {
+          try {
+            JsonObject o = new JsonObject();
+            o.add("astNode", protoValue(com.google.javascript.jscomp.serialization.AstNode.parseFrom(b)));
+            return o;
+          } catch (com.google.protobuf.InvalidProtocolBufferException ex) {
+            // not an AstNode: falls back to the bytes
+          }
+        }
+        JsonObject o = new JsonObject();
+        o.addProperty("bytes", java.util.Base64.getEncoder().encodeToString(b.toByteArray()));
+        return o;
+      }
+      case LONG: {
+        JsonObject o = new JsonObject();
+        o.addProperty("long", x.toString());
+        return o;
+      }
+      case FLOAT:
+      case DOUBLE: {
+        JsonObject o = new JsonObject();
+        o.addProperty("double", Double.toString(((Number) x).doubleValue()));
+        return o;
+      }
+      case BOOLEAN:
+        return new JsonPrimitive((Boolean) x);
+      case INT:
+        return new JsonPrimitive((Integer) x);
+      default:
+        return new JsonPrimitive(String.valueOf(x));
+    }
+  }
+
+  /** Dumps the non-static fields of v declared in classes from c up to (excluding) stop. */
+  public static JsonObject fields(Object v, Class<?> c, Class<?> stop, String path, JsonArray unrep, int depthLeft) {
+    return fields(v, c, stop, path, unrep, depthLeft, new IdentityHashMap<>());
+  }
+
+  private static JsonObject fields(
+      Object v, Class<?> c, Class<?> stop, String path, JsonArray unrep, int depthLeft,
+      IdentityHashMap<Object, Boolean> seen) {
+    JsonObject o = new JsonObject();
+    for (Class<?> k = c; k != null && k != stop && k != Object.class; k = k.getSuperclass()) {
+      for (Field f : k.getDeclaredFields()) {
+        if (Modifier.isStatic(f.getModifiers()) || f.isSynthetic()) {
+          continue;
+        }
+        String name = (k == c ? "" : k.getSimpleName() + ".") + f.getName();
+        if (o.has(name)) {
+          name = k.getName() + "." + f.getName();
+        }
+        try {
+          f.setAccessible(true);
+          o.add(name, dump(f.get(v), path + "." + name, unrep, depthLeft, seen));
+        } catch (ReflectiveOperationException | RuntimeException e) {
+          if (REFS.get()) {
+            o.add(name, ref(f.getType().getName()));
+          } else {
+            unrep(unrep, path + "." + name, "reflection failed: " + e);
+          }
+        }
+      }
+    }
+    return o;
+  }
+
+  /** Diff of options against new CompilerOptions(): field name -> value (only differing ones). */
+  public static JsonObject optionsDiff(CompilerOptions opts, JsonArray unrep) {
+    JsonObject diff = new JsonObject();
+    if (opts == null) {
+      return null;
+    }
+    CompilerOptions def = new CompilerOptions();
+    JsonArray scratch = new JsonArray();
+    JsonObject a = fields(opts, opts.getClass(), Object.class, "options", scratch, 4);
+    JsonObject b = fields(def, def.getClass(), Object.class, "default", new JsonArray(), 4);
+    for (String k : a.keySet()) {
+      JsonElement va = a.get(k);
+      JsonElement vb = b.get(k);
+      if (!GSON.toJson(va).equals(GSON.toJson(vb))) {
+        diff.add(k, va);
+        // keep only the unrepresentable entries that belong to differing fields
+        for (JsonElement u : scratch) {
+          String p = u.getAsJsonObject().get("path").getAsString();
+          if (p.equals("options." + k) || p.startsWith("options." + k + ".") || p.startsWith("options." + k + "[")
+              || p.startsWith("options." + k + "{")) {
+            unrep.add(u);
+          }
+        }
+      }
+    }
+    if (opts.getClass() != CompilerOptions.class) {
+      diff.addProperty("@class", opts.getClass().getName());
+    }
+    return diff;
+  }
+
+  /** Names of non-private instance methods declared in base that the instance's class overrides. */
+  public static JsonArray overrides(Object instance, Class<?> base) {
+    JsonArray a = new JsonArray();
+    List<String> seen = new ArrayList<>();
+    for (Class<?> b = base; b != null && b != Object.class; b = b.getSuperclass()) {
+      for (Method m : b.getDeclaredMethods()) {
+        int mod = m.getModifiers();
+        if (Modifier.isPrivate(mod) || Modifier.isStatic(mod) || Modifier.isFinal(mod) || m.isSynthetic()) {
+          continue;
+        }
+        for (Class<?> k = instance.getClass(); k != null && k != base; k = k.getSuperclass()) {
+          try {
+            Method o = k.getDeclaredMethod(m.getName(), m.getParameterTypes());
+            String sig = m.getName() + sigOf(m);
+            if (!o.isSynthetic() && !seen.contains(sig)) {
+              seen.add(sig);
+              JsonObject e = new JsonObject();
+              e.addProperty("method", sig);
+              e.addProperty("declaredIn", k.getName());
+              a.add(e);
+            }
+            break;
+          } catch (NoSuchMethodException e) {
+            // continue
+          }
+        }
+      }
+    }
+    List<JsonElement> sorted = new ArrayList<>();
+    a.forEach(sorted::add);
+    sorted.sort(
+        (x, y) ->
+            (x.getAsJsonObject().get("method").getAsString() + " " + x.getAsJsonObject().get("declaredIn").getAsString())
+                .compareTo(
+                    y.getAsJsonObject().get("method").getAsString() + " "
+                        + y.getAsJsonObject().get("declaredIn").getAsString()));
+    JsonArray out = new JsonArray();
+    sorted.forEach(out::add);
+    return out;
+  }
+
+  private static String sigOf(Method m) {
+    StringBuilder sb = new StringBuilder("(");
+    Class<?>[] p = m.getParameterTypes();
+    for (int i = 0; i < p.length; i++) {
+      if (i > 0) {
+        sb.append(',');
+      }
+      sb.append(p[i].getSimpleName());
+    }
+    return sb.append(')').toString();
+  }
+
+  /** Dumps the test instance's own fields (declared below the harness base class). */
+  public static JsonObject testFields(Object instance, Class<?> harnessBase, JsonArray unrep) {
+    return refFields(instance, instance.getClass(), harnessBase, "test", 2);
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // Post-call snapshot (FORMAT.md "Post-call snapshot"): a fixed set of compiler-result accessors,
+  // read right after the hooked call. Shared by the recorder and by replay (oracle/replay), so both
+  // sides compute it with the same code.
+  // ---------------------------------------------------------------------------------------------
+
+  /** Result producers: pass class FQCN, snapshot key, accessor (method name, or "field:name"). */
+  public static final String[][] RESULT_PRODUCERS = {
+    {"com.google.javascript.jscomp.RenameVars", "pass.variableMap", "getVariableMap"},
+    {"com.google.javascript.jscomp.RenameProperties", "pass.propertyMap", "getPropertyMap"},
+    {"com.google.javascript.jscomp.ReplaceStrings", "pass.stringMap", "getStringMap"},
+    {"com.google.javascript.jscomp.disambiguate.AmbiguateProperties", "pass.ambiguatedPropertyMap", "field:renamingMap"},
+    {"com.google.javascript.jscomp.ReplaceIdGenerators", "pass.idGeneratorMappings", "getSerializedIdMappings"},
+    {"com.google.javascript.jscomp.GatherRawExports", "pass.exportedVariableNames", "getExportedVariableNames"},
+    {"com.google.javascript.jscomp.CheckRegExp", "pass.globalRegExpPropertiesUsed", "isGlobalRegExpPropertiesUsed"},
+  };
+
+  /**
+   * The snapshot: {"compiler": {key: value}, "pass": {key: value}}; absent keys mean the accessor
+   * returned null or no producer was reachable. Producers are searched in the processor (first
+   * repetition), its fields to object depth 2 (list/array items included), then the given extra
+   * roots (the test instance's own fields, or replay's helper objects).
+   */
+  /**
+   * D-017 item 1 (FORMAT.md "Postcondition data"): test classes whose postcondition lambdas assert
+   * state that the snapshot captures as replay-compared data. Their lambdas are recorded as
+   * class-name references ({@code postconditionLambda}), not as unrepresentable placeholders:
+   * PureFunctionIdentifierTest (side-effect flags of CALL/NEW/TAGGED_TEMPLATELIT nodes, {@code
+   * postCall.postcondition.sideEffectFlags}), ExternExportsPassTest (the generated externs, {@code
+   * postCall.compiler.externExport}), GatherExternPropertiesTest (the gathered set, {@code
+   * postCall.compiler.externProperties}), ScopedAliasesTest (the JSDoc type nodes its
+   * TypeVerifyingPass compares, {@code postCall.postcondition.jsdocTypes}).
+   */
+  public static final Set<String> POSTCONDITION_DATA_CLASSES =
+      Set.of(
+          "com.google.javascript.jscomp.PureFunctionIdentifierTest",
+          "com.google.javascript.jscomp.ExternExportsPassTest",
+          "com.google.javascript.jscomp.GatherExternPropertiesTest",
+          "com.google.javascript.jscomp.ScopedAliasesTest");
+
+  /** True when the postcondition object is a lambda of a POSTCONDITION_DATA_CLASSES class. */
+  public static boolean postconditionDataLambda(Object postcondition) {
+    if (postcondition == null) {
+      return false;
+    }
+    String n = className(postcondition.getClass());
+    int i = n.indexOf('$');
+    return isLambda(postcondition.getClass()) && i > 0 && POSTCONDITION_DATA_CLASSES.contains(n.substring(0, i));
+  }
+
+  public static JsonObject postCallSnapshot(Compiler compiler, Object processor, List<Object> extraRoots) {
+    return postCallSnapshot(compiler, processor, extraRoots, null);
+  }
+
+  /**
+   * As above; with a non-null {@code postconditionCompiler} (the compiler the hooked call's
+   * postconditions verify; given only when it ran at least one) the snapshot also holds {@code
+   * postcondition}: the state postcondition lambdas assert, read from that compiler (D-017 item 1,
+   * FORMAT.md "Postcondition data"). It is the outermost call's compiler even when a nested hooked
+   * call replaced the test's lastCompiler.
+   */
+  public static JsonObject postCallSnapshot(
+      Compiler compiler, Object processor, List<Object> extraRoots, Compiler postconditionCompiler) {
+    JsonObject snap = new JsonObject();
+    JsonObject comp = new JsonObject();
+    if (compiler != null) {
+      try {
+        Set<String> ep = compiler.getExternProperties();
+        if (ep != null) {
+          comp.add("externProperties", refValue(ep, "post.externProperties", 2));
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("externPropertiesError", e.getClass().getName());
+      }
+      variableMap(comp, "variableMap", () -> compiler.getVariableMap());
+      variableMap(comp, "propertyMap", () -> compiler.getPropertyMap());
+      variableMap(comp, "stringMap", () -> compiler.getStringMap());
+      try {
+        AccessorSummary as = compiler.getAccessorSummary();
+        if (as != null) {
+          comp.add("accessorSummary", refValue(as.getAccessors(), "post.accessorSummary", 2));
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("accessorSummaryError", e.getClass().getName());
+      }
+      try {
+        com.google.javascript.jscomp.modules.ModuleMetadataMap mm = compiler.getModuleMetadataMap();
+        if (mm != null) {
+          JsonObject byPath = new JsonObject();
+          for (Map.Entry<String, com.google.javascript.jscomp.modules.ModuleMetadataMap.ModuleMetadata> e :
+              mm.getModulesByPath().entrySet()) {
+            byPath.add(e.getKey(), moduleMetadata(e.getValue()));
+          }
+          comp.add("moduleMetadataByPath", byPath);
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("moduleMetadataError", e.getClass().getName());
+      }
+      try {
+        SourceMap sm = compiler.getSourceMap();
+        if (sm != null) {
+          StringBuilder sb = new StringBuilder();
+          sm.appendTo(sb, "out.js");
+          comp.addProperty("sourceMap", sb.toString());
+        }
+      } catch (IOException | RuntimeException e) {
+        comp.addProperty("sourceMapError", e.getClass().getName());
+      }
+      // Architect harness round: the TypeValidator's recorded mismatches, in recording order, as
+      // {found, required} JSType.toString() strings. Compiler.getTypeMismatches() throws before type
+      // checking has run; then there is no key. Present only when non-empty.
+      try {
+        JsonArray tm = new JsonArray();
+        for (TypeMismatch m : compiler.getTypeMismatches()) {
+          JsonObject e = new JsonObject();
+          e.addProperty("found", String.valueOf(m.found()));
+          e.addProperty("required", String.valueOf(m.required()));
+          tm.add(e);
+        }
+        if (tm.size() > 0) {
+          comp.add("typeMismatches", tm);
+        }
+      } catch (RuntimeException e) {
+        if (!String.valueOf(e.getMessage()).startsWith("Can't ask for type mismatches before type checking")) {
+          comp.addProperty("typeMismatchesError", e.getClass().getName());
+        }
+      }
+      // Architect harness round: Compiler.runJ2clPasses() (set by J2clSourceFileChecker); present
+      // only when true.
+      if (compiler.runJ2clPasses()) {
+        comp.addProperty("runJ2clPasses", true);
+      }
+      // D-017 item 2 (FORMAT.md "Post-call snapshot"): neutral compiler keys.
+      // injectedLibraries: RuntimeJsLibManager.getInjectedLibraries() in injection order; present
+      // only when non-empty.
+      try {
+        List<String> libs = compiler.getRuntimeJsLibManager().getInjectedLibraries();
+        if (libs != null && !libs.isEmpty()) {
+          JsonArray a = new JsonArray();
+          for (String l : libs) {
+            a.add(l);
+          }
+          comp.add("injectedLibraries", a);
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("injectedLibrariesError", e.getClass().getName());
+      }
+      // allowableFeatures: getAllowableFeatures() as FeatureSet.Feature names in enum order; present
+      // when the compiler has a feature set.
+      try {
+        com.google.javascript.jscomp.parsing.parser.FeatureSet fs = compiler.getAllowableFeatures();
+        if (fs != null) {
+          JsonArray a = new JsonArray();
+          for (com.google.javascript.jscomp.parsing.parser.FeatureSet.Feature ft :
+              com.google.javascript.jscomp.parsing.parser.FeatureSet.Feature.values()) {
+            if (fs.has(ft)) {
+              a.add(ft.name());
+            }
+          }
+          comp.add("allowableFeatures", a);
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("allowableFeaturesError", e.getClass().getName());
+      }
+      // packageJsonMainEntries: getModuleLoader().getPackageJsonMainEntries() (string -> string, in
+      // the loader's map order); present only when non-empty.
+      try {
+        com.google.javascript.jscomp.deps.ModuleLoader ml = compiler.getModuleLoader();
+        Map<String, String> pj = ml == null ? null : ml.getPackageJsonMainEntries();
+        if (pj != null && !pj.isEmpty()) {
+          comp.add("packageJsonMainEntries", refValue(pj, "post.packageJsonMainEntries", 1));
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("packageJsonMainEntriesError", e.getClass().getName());
+      }
+      // typedPercent: ErrorManager.getTypedPercent() as {"double": Double.toString}; present only
+      // when non-zero (it is set only when type checking computed it).
+      try {
+        double tp = compiler.getErrorManager().getTypedPercent();
+        if (tp != 0.0) {
+          JsonObject o = new JsonObject();
+          o.addProperty("double", Double.toString(tp));
+          comp.add("typedPercent", o);
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("typedPercentError", e.getClass().getName());
+      }
+      // moduleMapBoundNames: {module path: [bound local names in boundNames() order]} of
+      // getModuleMap(); present only when the module map is set and non-empty.
+      try {
+        com.google.javascript.jscomp.modules.ModuleMap mmap = compiler.getModuleMap();
+        if (mmap != null && !mmap.getModulesByPath().isEmpty()) {
+          JsonObject byPath = new JsonObject();
+          for (Map.Entry<String, com.google.javascript.jscomp.modules.Module> e : mmap.getModulesByPath().entrySet()) {
+            JsonArray a = new JsonArray();
+            for (String n : e.getValue().boundNames().keySet()) {
+              a.add(n);
+            }
+            byPath.add(e.getKey(), a);
+          }
+          comp.add("moduleMapBoundNames", byPath);
+        }
+      } catch (RuntimeException e) {
+        comp.addProperty("moduleMapBoundNamesError", e.getClass().getName());
+      }
+    }
+    snap.add("compiler", comp);
+    JsonObject pass = new JsonObject();
+    List<Object> objs = new ArrayList<>();
+    IdentityHashMap<Object, Boolean> seen = new IdentityHashMap<>();
+    collect(processor, 2, objs, seen);
+    if (extraRoots != null) {
+      for (Object r : extraRoots) {
+        collect(r, 1, objs, seen);
+      }
+    }
+    for (Object o : objs) {
+      for (String[] p : RESULT_PRODUCERS) {
+        if (pass.has(p[1]) || !isInstance(o.getClass(), p[0])) {
+          continue;
+        }
+        try {
+          Object v;
+          if (p[2].startsWith("field:")) {
+            Field f = findField(o.getClass(), p[2].substring(6));
+            f.setAccessible(true);
+            v = f.get(o);
+          } else {
+            Method m = findMethod(o.getClass(), p[2]);
+            m.setAccessible(true);
+            v = m.invoke(o);
+          }
+          if (v instanceof VariableMap vm) {
+            v = vm.getOriginalNameToNewNameMap();
+          }
+          if (v != null) {
+            pass.add(p[1], refValue(v, "post." + p[1], 2));
+          }
+        } catch (ReflectiveOperationException | RuntimeException e) {
+          Throwable c = e instanceof java.lang.reflect.InvocationTargetException ite ? ite.getCause() : e;
+          pass.addProperty(p[1] + "Error", c == null ? e.getClass().getName() : c.getClass().getName());
+        }
+      }
+    }
+    // Architect harness round: pass.referenceMap, the state of the first reachable ReferenceCollector:
+    // its collected variables in collection order (LinkedHashMap), each with its references.
+    for (Object o : objs) {
+      if (pass.has("pass.referenceMap") || pass.has("pass.referenceMapError") || !(o instanceof ReferenceCollector)) {
+        continue;
+      }
+      ReferenceCollector rc = (ReferenceCollector) o;
+      try {
+        JsonArray vars = new JsonArray();
+        for (Var v : rc.getAllSymbols()) {
+          ReferenceCollection refs = rc.getReferences(v);
+          JsonObject vo = new JsonObject();
+          vo.addProperty("name", v.getName());
+          vo.addProperty("scopeRoot", nodePos(v.getScopeRoot()));
+          vo.addProperty("isAssignedOnceInLifetime", refs.isAssignedOnceInLifetime());
+          vo.addProperty("isWellDefined", refs.isWellDefined());
+          JsonArray ra = new JsonArray();
+          for (Reference r : refs.references) {
+            JsonObject ro = new JsonObject();
+            ro.addProperty("node", nodePos(r.getNode()));
+            ro.addProperty("isDeclaration", r.isDeclaration());
+            ro.addProperty("isInitializingDeclaration", r.isInitializingDeclaration());
+            ro.addProperty("isLvalue", r.isLvalue());
+            ra.add(ro);
+          }
+          vo.add("references", ra);
+          vars.add(vo);
+        }
+        pass.add("pass.referenceMap", vars);
+      } catch (RuntimeException e) {
+        pass.addProperty("pass.referenceMapError", e.getClass().getName());
+      }
+    }
+    // Architect harness round: pass.crossChunkReferences, the state of the first reachable
+    // CrossChunkReferenceCollector: global variables in varsByName order with their references, and
+    // the top-level statements (references named "<var>#<index in that var's references>").
+    for (Object o : objs) {
+      if (pass.has("pass.crossChunkReferences") || pass.has("pass.crossChunkReferencesError")
+          || !(o instanceof CrossChunkReferenceCollector)) {
+        continue;
+      }
+      CrossChunkReferenceCollector cc = (CrossChunkReferenceCollector) o;
+      try {
+        JsonObject out = new JsonObject();
+        JsonArray vars = new JsonArray();
+        IdentityHashMap<Reference, String> refIds = new IdentityHashMap<>();
+        for (Map.Entry<String, Var> e : cc.getGlobalVariableNamesMap().entrySet()) {
+          ReferenceCollection refs = cc.getReferences(e.getValue());
+          JsonObject vo = new JsonObject();
+          vo.addProperty("name", e.getKey());
+          if (refs == null) {
+            vo.add("references", JsonNull.INSTANCE);
+          } else {
+            vo.addProperty("isAssignedOnceInLifetime", refs.isAssignedOnceInLifetime());
+            vo.addProperty("isWellDefined", refs.isWellDefined());
+            JsonArray ra = new JsonArray();
+            int i = 0;
+            for (Reference r : refs.references) {
+              refIds.put(r, e.getKey() + "#" + i++);
+              JsonObject ro = new JsonObject();
+              ro.addProperty("node", nodePos(r.getNode()));
+              ro.addProperty("basicBlockRoot", r.getBasicBlock() == null ? null : nodePos(r.getBasicBlock().getRoot()));
+              ra.add(ro);
+            }
+            vo.add("references", ra);
+          }
+          vars.add(vo);
+        }
+        out.add("vars", vars);
+        JsonArray stmts = new JsonArray();
+        for (CrossChunkReferenceCollector.TopLevelStatement t : cc.getTopLevelStatements()) {
+          JsonObject so = new JsonObject();
+          so.addProperty("originalOrder", t.getOriginalOrder());
+          so.addProperty("statement", nodePos(t.getStatementNode()));
+          boolean decl = t.isDeclarationStatement();
+          so.addProperty("isDeclarationStatement", decl);
+          so.addProperty("isMovableDeclaration", t.isMovableDeclaration());
+          so.addProperty("declaredNameReference", decl ? refId(refIds, t.getDeclaredNameReference()) : null);
+          JsonArray nd = new JsonArray();
+          for (Reference r : t.getNonDeclarationReferences()) {
+            nd.add(refId(refIds, r));
+          }
+          so.add("nonDeclarationReferences", nd);
+          com.google.javascript.rhino.Node vn = t.getDeclaredValueNode();
+          so.addProperty("declaredValueNode", nodePos(vn));
+          if (vn != null && vn.isNumber()) {
+            so.addProperty("declaredValueNumber", String.valueOf(vn.getDouble()));
+          }
+          stmts.add(so);
+        }
+        out.add("topLevelStatements", stmts);
+        pass.add("pass.crossChunkReferences", out);
+      } catch (RuntimeException e) {
+        pass.addProperty("pass.crossChunkReferencesError", e.getClass().getName());
+      }
+    }
+    snap.add("pass", pass);
+    if (postconditionCompiler != null) {
+      snap.add("postcondition", postconditionData(postconditionCompiler));
+    }
+    return snap;
+  }
+
+  /** True when n is in the JS root (not the externs). */
+  private static boolean inJs(Compiler compiler, com.google.javascript.rhino.Node n) {
+    com.google.javascript.rhino.Node js = compiler.getJsRoot();
+    for (com.google.javascript.rhino.Node p = n; p != null; p = p.getParent()) {
+      if (p == js) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /** D-017 item 1: output-AST state asserted by postcondition lambdas (FORMAT.md "Postcondition data"):
+   * sideEffectFlags = [node, callee qualified name or null, Node.getSideEffectFlags()] of every
+   * CALL/NEW/TAGGED_TEMPLATELIT/OPTCHAIN_CALL node of externs and JS (pre-order); jsdocTypes = [node,
+   * [toStringTree of each JSDoc type node]] of every JS-root node whose JSDoc has type nodes. */
+  private static JsonObject postconditionData(Compiler compiler) {
+    JsonObject o = new JsonObject();
+    JsonArray flags = new JsonArray();
+    JsonArray types = new JsonArray();
+    try {
+      com.google.javascript.rhino.Node root = compiler.getRoot();
+      if (root != null) {
+        NodeUtil.visitPreOrder(
+            root,
+            n -> {
+              if (n.isCall() || n.isNew() || n.isTaggedTemplateLit() || n.isOptChainCall()) {
+                JsonArray e = new JsonArray();
+                e.add(nodePos(n));
+                com.google.javascript.rhino.Node callee = n.getFirstChild();
+                e.add(callee != null && callee.isQualifiedName() ? callee.getQualifiedName() : null);
+                e.add(n.getSideEffectFlags());
+                flags.add(e);
+              }
+              com.google.javascript.rhino.JSDocInfo info = n.getJSDocInfo();
+              if (info != null && !info.getTypeNodes().isEmpty() && inJs(compiler, n)) {
+                JsonArray e = new JsonArray();
+                e.add(nodePos(n));
+                JsonArray tn = new JsonArray();
+                for (com.google.javascript.rhino.Node t : info.getTypeNodes()) {
+                  tn.add(t.toStringTree());
+                }
+                e.add(tn);
+                types.add(e);
+              }
+            });
+      }
+      o.add("sideEffectFlags", flags);
+      o.add("jsdocTypes", types);
+    } catch (RuntimeException e) {
+      o.addProperty("error", e.getClass().getName());
+    }
+    // ExternExportsPassTest: the generated externs the lambda hands to its consumer.
+    try {
+      String ee = compiler.getResult().externExport;
+      o.addProperty("externExport", ee);
+    } catch (RuntimeException e) {
+      o.addProperty("externExportError", e.getClass().getName());
+    }
+    // GatherExternPropertiesTest: the gathered set (also in compiler.externProperties of the
+    // snapshot's own compiler).
+    try {
+      Set<String> ep = compiler.getExternProperties();
+      if (ep != null) {
+        JsonArray a = new JsonArray();
+        for (String x : new java.util.TreeSet<>(ep)) {
+          a.add(x);
+        }
+        o.add("externProperties", a);
+      }
+    } catch (RuntimeException e) {
+      o.addProperty("externPropertiesError", e.getClass().getName());
+    }
+    return o;
+  }
+
+  private static String refId(IdentityHashMap<Reference, String> ids, Reference r) {
+    String id = ids.get(r);
+    return id != null ? id : "unlisted " + nodePos(r.getNode());
+  }
+
+  /** "TOKEN source:line:column" of a node (null for null), for post-call snapshots. */
+  private static String nodePos(com.google.javascript.rhino.Node n) {
+    if (n == null) {
+      return null;
+    }
+    return n.getToken() + " " + n.getSourceFileName() + ":" + n.getLineno() + ":" + n.getCharno();
+  }
+
+  /** Test-instance fields (declared below base) as extra producer roots. */
+  public static List<Object> ownFieldValues(Object instance, Class<?> base) {
+    List<Object> out = new ArrayList<>();
+    if (instance == null) {
+      return out;
+    }
+    for (Class<?> k = instance.getClass(); k != null && k != base && k != Object.class; k = k.getSuperclass()) {
+      for (Field f : k.getDeclaredFields()) {
+        if (Modifier.isStatic(f.getModifiers()) || f.isSynthetic() || f.getType().isPrimitive()) {
+          continue;
+        }
+        try {
+          f.setAccessible(true);
+          Object v = f.get(instance);
+          if (v != null) {
+            out.add(v);
+          }
+        } catch (ReflectiveOperationException | RuntimeException e) {
+          // not readable: not a producer root
+        }
+      }
+    }
+    return out;
+  }
+
+  private interface VmSupplier {
+    VariableMap get();
+  }
+
+  private static void variableMap(JsonObject comp, String key, VmSupplier s) {
+    try {
+      VariableMap vm = s.get();
+      if (vm != null) {
+        comp.add(key, refValue(vm.getOriginalNameToNewNameMap(), "post." + key, 2));
+      }
+    } catch (RuntimeException e) {
+      comp.addProperty(key + "Error", e.getClass().getName());
+    }
+  }
+
+  private static JsonObject moduleMetadata(com.google.javascript.jscomp.modules.ModuleMetadataMap.ModuleMetadata m) {
+    JsonObject o = new JsonObject();
+    o.add("moduleType", refValue(m.moduleType(), "post.m", 1));
+    o.addProperty("usesClosure", m.usesClosure());
+    o.addProperty("isTestOnly", m.isTestOnly());
+    o.add("googNamespaces", refValue(m.googNamespaces(), "post.m", 1));
+    o.add("stronglyRequiredGoogNamespaces", refValue(m.stronglyRequiredGoogNamespaces(), "post.m", 1));
+    o.add("dynamicallyRequiredGoogNamespaces", refValue(m.dynamicallyRequiredGoogNamespaces(), "post.m", 1));
+    o.add("maybeRequiredGoogNamespaces", refValue(m.maybeRequiredGoogNamespaces(), "post.m", 1));
+    o.add("weaklyRequiredGoogNamespaces", refValue(m.weaklyRequiredGoogNamespaces(), "post.m", 1));
+    o.add("es6ImportSpecifiers", refValue(m.es6ImportSpecifiers(), "post.m", 1));
+    o.add("readToggles", refValue(m.readToggles(), "post.m", 1));
+    // D-017 item 2: the nested goog.loadModule modules' metadata in full (recursively), in
+    // nestedModules() order (was a count before; the list size is that count).
+    JsonArray nested = new JsonArray();
+    for (com.google.javascript.jscomp.modules.ModuleMetadataMap.ModuleMetadata n : m.nestedModules()) {
+      nested.add(moduleMetadata(n));
+    }
+    o.add("nestedModules", nested);
+    return o;
+  }
+
+  private static boolean isInstance(Class<?> c, String fqcn) {
+    for (Class<?> k = c; k != null; k = k.getSuperclass()) {
+      if (k.getName().equals(fqcn)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static Field findField(Class<?> c, String name) throws NoSuchFieldException {
+    for (Class<?> k = c; k != null; k = k.getSuperclass()) {
+      try {
+        return k.getDeclaredField(name);
+      } catch (NoSuchFieldException e) {
+        // continue
+      }
+    }
+    throw new NoSuchFieldException(name);
+  }
+
+  private static Method findMethod(Class<?> c, String name) throws NoSuchMethodException {
+    for (Class<?> k = c; k != null; k = k.getSuperclass()) {
+      try {
+        return k.getDeclaredMethod(name);
+      } catch (NoSuchMethodException e) {
+        // continue
+      }
+    }
+    throw new NoSuchMethodException(name);
+  }
+
+  /** Objects reachable from root through instance fields (and list/array items) to depth d. */
+  private static void collect(Object root, int d, List<Object> out, IdentityHashMap<Object, Boolean> seen) {
+    if (root == null || seen.containsKey(root)) {
+      return;
+    }
+    Class<?> c = root.getClass();
+    if (c.isPrimitive() || root instanceof String || root instanceof Number || root instanceof Boolean
+        || root instanceof Enum || root instanceof Compiler || root instanceof com.google.javascript.rhino.Node) {
+      return;
+    }
+    seen.put(root, true);
+    if (root instanceof Collection<?> col) {
+      if (d > 0) {
+        for (Object x : col) {
+          collect(x, d - 1, out, seen);
+        }
+      }
+      return;
+    }
+    if (c.isArray()) {
+      if (d > 0 && !c.getComponentType().isPrimitive()) {
+        for (int i = 0; i < Array.getLength(root); i++) {
+          collect(Array.get(root, i), d - 1, out, seen);
+        }
+      }
+      return;
+    }
+    if (root instanceof Map) {
+      return;
+    }
+    out.add(root);
+    if (d <= 0 || c.getName().startsWith("java.") || c.getName().startsWith("com.google.common.")) {
+      return;
+    }
+    for (Class<?> k = c; k != null && k != Object.class; k = k.getSuperclass()) {
+      for (Field f : k.getDeclaredFields()) {
+        if (Modifier.isStatic(f.getModifiers()) || f.getType().isPrimitive()) {
+          continue;
+        }
+        try {
+          f.setAccessible(true);
+          collect(f.get(root), d - 1, out, seen);
+        } catch (ReflectiveOperationException | RuntimeException e) {
+          // unreadable field: skipped
+        }
+      }
+    }
+  }
+
+  public static synchronized Map<String, Integer> snapshot(Map<String, Integer> m) {
+    return new LinkedHashMap<>(m);
+  }
+}
diff --git a/test/com/google/javascript/jscomp/UnitRecordingMain.java b/test/com/google/javascript/jscomp/UnitRecordingMain.java
new file mode 100644
index 0000000..4d58505
--- /dev/null
+++ b/test/com/google/javascript/jscomp/UnitRecordingMain.java
@@ -0,0 +1,134 @@
+/*
+ * closure-rs unit-corpus recording runner (oracle/patches/0002-recording-hooks.patch).
+ * Runs JUnit test classes with plain JUnitCore and the UnitRecorder hook enabled.
+ * Usage: java -Dclosurers.unit.record=true ... UnitRecordingMain REC_DIR STAT_DIR RECORD_NAME CLASS_FQCN
+ * Writes REC_DIR/RECORD_NAME.jsonl.gz and STAT_DIR/RECORD_NAME.json (atomically; the stats file last).
+ */
+package com.google.javascript.jscomp;
+
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.io.BufferedWriter;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.StandardCopyOption;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.junit.runner.Description;
+import org.junit.runner.JUnitCore;
+import org.junit.runner.Request;
+import org.junit.runner.Result;
+import org.junit.runner.notification.Failure;
+import org.junit.runner.notification.RunListener;
+
+/** Recording runner; not a test. */
+public final class UnitRecordingMain {
+  private UnitRecordingMain() {}
+
+  public static void main(String[] args) throws Exception {
+    Path recDir = Paths.get(args[0]);
+    Path statDir = Paths.get(args[1]);
+    String recName = args[2];
+    String className = args[3];
+    Files.createDirectories(recDir);
+    Files.createDirectories(statDir);
+    Path recTmp = recDir.resolve(recName + ".jsonl.gz.tmp");
+    Path recFinal = recDir.resolve(recName + ".jsonl.gz");
+    Path statTmp = statDir.resolve(recName + ".json.tmp");
+    Path statFinal = statDir.resolve(recName + ".json");
+
+    Map<String, JsonObject> tests = new LinkedHashMap<>();
+    JsonObject stats = new JsonObject();
+    stats.addProperty("class", className);
+    stats.addProperty("record", recName);
+    long t0 = System.currentTimeMillis();
+    try (Writer w =
+        new BufferedWriter(
+            new OutputStreamWriter(
+                new java.util.zip.GZIPOutputStream(Files.newOutputStream(recTmp), 1 << 16),
+                StandardCharsets.UTF_8),
+            1 << 16)) {
+      UnitRecorder.setOutput(w);
+      Class<?> cls = Class.forName(className);
+      JUnitCore core = new JUnitCore();
+      core.addListener(
+          new RunListener() {
+            @Override
+            public void testStarted(Description d) {
+              UnitRecorder.currentClass = d.getClassName();
+              UnitRecorder.currentMethod = d.getMethodName();
+              JsonObject t = new JsonObject();
+              t.addProperty("status", "passed");
+              tests.put(d.getClassName() + "#" + d.getMethodName(), t);
+            }
+
+            @Override
+            public void testFinished(Description d) {
+              UnitRecorder.currentMethod = null;
+            }
+
+            @Override
+            public void testFailure(Failure f) {
+              Description d = f.getDescription();
+              JsonObject t =
+                  tests.computeIfAbsent(d.getClassName() + "#" + d.getMethodName(), k -> new JsonObject());
+              t.addProperty("status", "failed");
+              Throwable e = f.getException();
+              t.addProperty("exception", e == null ? null : e.getClass().getName());
+              String m = f.getMessage();
+              t.addProperty("message", m == null ? null : m.substring(0, Math.min(m.length(), 2000)));
+            }
+
+            @Override
+            public void testAssumptionFailure(Failure f) {
+              Description d = f.getDescription();
+              JsonObject t =
+                  tests.computeIfAbsent(d.getClassName() + "#" + d.getMethodName(), k -> new JsonObject());
+              t.addProperty("status", "assumption_failed");
+            }
+
+            @Override
+            public void testIgnored(Description d) {
+              JsonObject t = new JsonObject();
+              t.addProperty("status", "ignored");
+              tests.put(d.getClassName() + "#" + d.getMethodName(), t);
+            }
+          });
+      Result r = core.run(Request.aClass(cls));
+      stats.addProperty("runCount", r.getRunCount());
+      stats.addProperty("failureCount", r.getFailureCount());
+      stats.addProperty("ignoreCount", r.getIgnoreCount());
+      stats.addProperty("assumptionFailureCount", r.getAssumptionFailureCount());
+      UnitRecorder.setOutput(null);
+    }
+    stats.addProperty("millis", System.currentTimeMillis() - t0);
+    stats.addProperty("records", UnitRecorder.recordsWritten);
+    stats.addProperty("recordsWithUnrepresentable", UnitRecorder.recordsWithUnrepresentable);
+    JsonObject entries = new JsonObject();
+    UnitRecorder.snapshot(UnitRecorder.entries).forEach(entries::addProperty);
+    stats.add("entries", entries);
+    JsonObject outer = new JsonObject();
+    UnitRecorder.snapshot(UnitRecorder.outermost).forEach(outer::addProperty);
+    stats.add("outermost", outer);
+    JsonObject testObj = new JsonObject();
+    tests.forEach(testObj::add);
+    stats.add("tests", testObj);
+    Files.move(recTmp, recFinal, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+    Files.writeString(
+        statTmp, new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create().toJson(stats));
+    Files.move(statTmp, statFinal, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+    System.out.println(
+        "RECORDED " + className + " records=" + UnitRecorder.recordsWritten + " run=" + stats.get("runCount")
+            + " failed=" + stats.get("failureCount"));
+    System.exit(0);
+  }
+
+  static JsonArray unused() {
+    return new JsonArray();
+  }
+}
