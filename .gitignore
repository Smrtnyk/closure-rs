# Project-local toolchains (bazelisk, JDK 21) — see DECISIONS.md D-003
/tools/
# Pinned Java reference checkouts (scripts/fetch_reference.sh)
/reference/
# Build outputs (cargo target directories at any level, work directories and reports, npm packs)
/build/
target/
dist/
*.tgz
# Downloaded corpus inputs (re-fetched and hash-verified by scripts)
/corpus-cache/
# Node dependencies (npm/closure-rs has none; installed only for local tests)
node_modules/

# Python bytecode
__pycache__/
*.pyc

# Editors and OS
.idea/
.vscode/
.DS_Store

# D7 benchmark inputs (scripts/fetch_bench.sh)
/bench-cache/
# D7 benchmark results (scripts/run_bench.py); only the format README is tracked
/bench/results/*
!/bench/results/README.md
